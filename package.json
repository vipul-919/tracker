{
  "name": "website-work-hours-tracker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "24.x" },
  "config": { "mongodbMemoryServer": { "disablePostinstall": true } },
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch --env-file=.env server/index.js",
    "dev:client": "vite --host 127.0.0.1",
    "build": "vite build",
    "start": "node --env-file=.env server/index.js",
    "test": "node --test tests/*.test.js",
    "db": "node scripts/local-db.js",
    "setup": "node scripts/setup.js",
    "test:browser": "node scripts/browser-check.js"
  },
  "overrides": { "exceljs": { "uuid": "^11.1.1" } },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.468.0",
    "mongoose": "^8.19.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.2.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "mongodb-memory-server": "^10.2.3",
    "playwright-core": "^1.64.1",
    "supertest": "^7.1.4",
    "vite": "^7.1.9"
  }
}
